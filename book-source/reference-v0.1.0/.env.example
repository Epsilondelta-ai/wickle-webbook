# Live integration test configuration only. The library does not read this file.
# See docs/env/README.md. Model-specific live adapters/tests are being implemented.
# Enter each actual model ID (including its version/snapshot) once.
# Azure uses the deployment name; Bedrock accepts the actual modelId/profile/ARN.
# Add MODEL_2_..., MODEL_3_... slots to test more models or different options.
# A nonblank ID/deployment defines a test case. Blank optional options are omitted.
# Effort/thinking options must be supported by the selected model and API.
# Share credentials within a provider; use another .env file for another resource.
# Never commit the resulting .env.

# OpenAI GPT
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_1_ID=
OPENAI_MODEL_1_REASONING_EFFORT=
OPENAI_MODEL_1_MAX_OUTPUT_TOKENS=4096
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# Azure Foundry OpenAI GPT: resource origin, without /openai/v1/.
AZURE_OPENAI_ENDPOINT=
# ARM account ID for deployment model/version inspection (management Entra access required).
AZURE_OPENAI_RESOURCE_ID=
AZURE_OPENAI_MODEL_1_DEPLOYMENT=
AZURE_OPENAI_MODEL_1_REASONING_EFFORT=
AZURE_OPENAI_MODEL_1_MAX_OUTPUT_TOKENS=4096
AZURE_OPENAI_API_MODE=v1
# Only dated API mode requires this protocol version; leave empty for v1.
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_AUTH_MODE=api_key
AZURE_OPENAI_API_KEY=
# Entra mode: Azure CLI/managed identity, or an explicit service principal.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_OPENAI_ENTRA_SCOPE=https://ai.azure.com/.default

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MODEL_1_ID=
ANTHROPIC_MODEL_1_EFFORT=
ANTHROPIC_MODEL_1_MAX_OUTPUT_TOKENS=4096
# Only when the selected model requires an explicit thinking configuration:
# ANTHROPIC_MODEL_1_THINKING_MODE=
# ANTHROPIC_MODEL_1_THINKING_BUDGET_TOKENS=
# ANTHROPIC_WORKSPACE_ID=

# AWS Bedrock Claude: actual modelId, inference profile ID, or ARN.
AWS_REGION=
BEDROCK_MODEL_1_ID=
BEDROCK_MODEL_1_EFFORT=
BEDROCK_MODEL_1_MAX_OUTPUT_TOKENS=4096
# BEDROCK_MODEL_1_THINKING_MODE=
# BEDROCK_MODEL_1_THINKING_BUDGET_TOKENS=
# BEDROCK_ENDPOINT=
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Google AI Studio / Gemini API
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1
GEMINI_MODEL_1_ID=
GEMINI_MODEL_1_THINKING_LEVEL=
GEMINI_MODEL_1_MAX_OUTPUT_TOKENS=4096
# Use a token budget only for a model/API supporting it; omit thinking level then.
# GEMINI_MODEL_1_THINKING_BUDGET_TOKENS=

# Google Cloud Vertex AI Gemini (Application Default Credentials)
GOOGLE_CLOUD_PROJECT=
# The test Host selects the global endpoint; no location environment variable is required.
VERTEX_API_VERSION=v1
VERTEX_MODEL_1_ID=
VERTEX_MODEL_1_THINKING_LEVEL=
VERTEX_MODEL_1_MAX_OUTPUT_TOKENS=4096
# VERTEX_MODEL_1_THINKING_BUDGET_TOKENS=
# VERTEX_ENDPOINT=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_QUOTA_PROJECT=

# xAI Grok
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL_1_ID=
XAI_MODEL_1_REASONING_EFFORT=
XAI_MODEL_1_MAX_OUTPUT_TOKENS=4096
