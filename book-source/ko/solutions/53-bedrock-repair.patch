+            json!({"code":"ModelStreamErrorException:legacy"}),
+            ModelFailureKind::Transport,
+        ),
+        (
+            Some("ModelErrorException"),
+            json!({"__type":"ModelStreamErrorException"}),
+            ModelFailureKind::Unsupported,
