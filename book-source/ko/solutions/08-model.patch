+        r#"{"query":"first","query":"second"}"#,
+        r#"{"query":"x","nested":{"key":1,"key":2}}"#,
+        r#"{"query":"x","limit":NaN}"#,
+        r#"{"query":"x"} trailing"#,
+        "[]",
+        "null",
+        "true",
+        "",
+        r#"{"query":"unfinished"#,
+    ] {
