+pub struct FixedClock;
+impl Clock for FixedClock {
+    fn now(&self) -> Result<ClockReading, ContractError> {
+        Ok(ClockReading {
+            utc_ms: 0,
+            monotonic_ms: 0,
+        })
+    }
+    fn sleep_until<'a>(&'a self, deadline: u64) -> PortFuture<'a, ()> {
+        if deadline == 0 {
+            Box::pin(async { Ok(()) })
+        } else {
+            Box::pin(std::future::pending())
+        }
+    }
+}
