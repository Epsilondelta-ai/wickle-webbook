+    assert_eq!(
+        new_router.resolve(&request()).await.unwrap().route.binding,
+        versioned("second")
+    );
+    let restored = RoutingSnapshot::restore(&encoded, &scope(), &digest).unwrap();
+    let restored = PolicyModelRouter::new(restored).unwrap();
