+    for (index, name) in ["primary", "second", "third"].into_iter().enumerate() {
+        let selected = router.resolve(&input).await.unwrap();
+        assert_eq!(selected.candidate_index, index);
+        assert_eq!(selected.route.binding, versioned(name));
