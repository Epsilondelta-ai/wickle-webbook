+        );
+        assert_eq!(
+            std::fs::read_to_string(directory.join("calls"))
+                .unwrap()
+                .lines()
+                .count(),
+            3
+        );
+        assert!(directory.join("verified").exists());
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+}
