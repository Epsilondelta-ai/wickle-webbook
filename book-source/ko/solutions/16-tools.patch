+                .keys()
+                .cloned()
+                .collect::<BTreeSet<_>>(),
+            ["query".to_owned(), "limit".to_owned()]
+                .into_iter()
+                .collect()
+        );
+    }
+    let calls: Vec<_> = requests[1]
+        .messages
+        .iter()
+        .flat_map(|message| &message.content)
+        .filter_map(|content| match content {
+            ModelContent::ToolCall {
+                provider_call_id,
+                name,
+                arguments,
+            } => Some((provider_call_id, name, arguments)),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(
+        calls,
+        vec![
+            (
+                &id("provider-0"),
+                &id("read"),
+                &object(json!({"query":"first"}))
