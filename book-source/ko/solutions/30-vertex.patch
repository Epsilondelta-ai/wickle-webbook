+        Box::pin(async move {
+            assert_eq!(context.project, "test-project");
+            assert_eq!(context.scope, &scope());
+            self.clock.store(10000, Ordering::SeqCst);
+            VertexToken::new(
+                "refreshed-token",
+                Some(UNIX_EPOCH + Duration::from_secs(if self.expired { 5 } else { 20 })),
+            )
+        })
+    }
