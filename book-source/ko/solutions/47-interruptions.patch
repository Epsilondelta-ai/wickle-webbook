+        }
+        Ok(())
+    }
+    pub(crate) fn default_identity() -> VersionedRef {
+        VersionedRef {
+            id: Id::new("wickle-default-interruption").expect("constant"),
+            version: Id::new("1").expect("constant"),
+        }
+    }
