+                profile,
+                AgentBindings {
+                    scope: scope.clone(),
+                    state: store,
+                    policy: policy.clone(),
+                    profile_resolver: catalog.clone(),
+                    model_exchange: Arc::new(
+                        ModelExchange::new(model, policy)
