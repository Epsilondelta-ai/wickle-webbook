+                memory,
+                memory_id,
+                graph: graph.clone(),
+                model: Arc::new(GatherModel {
+                    period,
+                    calls: AtomicUsize::new(0),
+                }),
+                tool: Arc::new(Lookup {
+                    scope: scope.clone(),
+                    calls: AtomicUsize::new(0),
