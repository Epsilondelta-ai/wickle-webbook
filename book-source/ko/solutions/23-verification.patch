+        &'a self,
+        input: &'a VerificationInput,
+        _: &'a VerifierContext<'a>,
+    ) -> PortFuture<'a, VerificationDecision> {
+        Box::pin(async move {
+            assert!(!input.candidate.evidence_message_ids.is_empty());
