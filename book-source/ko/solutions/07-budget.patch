+    assert_eq!(
+        budget
+            .execute(model(ModelPurpose::Agent), |_| counted(&effects))
+            .await
+            .unwrap_err()
+            .code,
+        ErrorCode::Cancelled
+    );
+    assert_eq!(effects.load(Ordering::SeqCst), 1);
+}
