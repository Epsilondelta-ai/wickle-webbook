+fn replace_reference(value: &mut Value, old: &Value, new: &Value) {
+    if value == old {
+        *value = new.clone();
+        return;
+    }
+    match value {
+        Value::Array(values) => values
+            .iter_mut()
+            .for_each(|value| replace_reference(value, old, new)),
+        Value::Object(values) => values
+            .values_mut()
+            .for_each(|value| replace_reference(value, old, new)),
+        _ => {}
+    }
+}
