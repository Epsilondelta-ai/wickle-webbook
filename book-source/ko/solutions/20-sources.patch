+pub fn projected_items(request: &ModelRequest) -> Vec<&Value> {
+    request
+        .messages
+        .iter()
+        .flat_map(|message| {
+            message
+                .content
+                .iter()
+                .filter_map(move |content| match content {
+                    ModelContent::Json { value } if value["kind"] == "context_data" => {
+                        assert_eq!(message.role, ModelRole::User);
+                        Some(value)
+                    }
+                    _ => None,
+                })
+        })
+        .collect()
+}
