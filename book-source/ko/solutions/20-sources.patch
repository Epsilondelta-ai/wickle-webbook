+        s: &'a Scope,
+        r: &'a Id,
+        l: &'a RunLease,
+        n: i64,
+    ) -> PortFuture<'a, ()> {
+        self.inner.release_lease(s, r, l, n)
+    }
+    fn read_events<'a>(
+        &'a self,
+        s: &'a Scope,
+        r: &'a Id,
+        a: u64,
+        n: usize,
+    ) -> PortFuture<'a, EventPage> {
