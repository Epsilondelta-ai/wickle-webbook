+    let mut update = prepared(&saved.snapshot, lease.clone(), 1);
+    update.snapshot.status = RunStatus::Waiting;
+    update.snapshot.phase = RunPhase::Waiting;
+    update.snapshot.wait = Some(wait);
+    update.snapshot.last_event_seq += 1;
