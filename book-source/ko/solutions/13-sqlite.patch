+impl Database {
+    pub fn new() -> Self {
+        let unique = RandomIdSource.next_id().unwrap();
+        let directory = std::env::temp_dir().join(format!("wickle-sqlite-test-{unique}"));
+        std::fs::create_dir(&directory).unwrap();
+        Self { directory }
+    }
