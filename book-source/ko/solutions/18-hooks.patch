+fn context_data(request: &ModelRequest) -> Vec<(ModelRole, &Value)> {
+    request
+        .messages
+        .iter()
+        .flat_map(|message| {
+            message.content.iter().filter_map(|content| match content {
+                ModelContent::Json { value } if value["kind"] == "context_data" => {
+                    Some((message.role, value))
+                }
+                _ => None,
+            })
+        })
+        .collect()
+}
