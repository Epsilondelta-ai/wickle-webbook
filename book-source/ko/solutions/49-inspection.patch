+    let counters = (
+        fixture.model.calls.load(Ordering::SeqCst),
+        fixture.catalog.calls.load(Ordering::SeqCst),
+        fixture.router.queries.load(Ordering::SeqCst),
+    );
+    let first = report(&reader, handle.run_id(), step.clone(), false).await;
